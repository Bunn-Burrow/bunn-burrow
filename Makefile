.DEFAULT_GOAL := help

BIN_DIR := bin
BINARIES := \
	$(BIN_DIR)/bunn-burrow \
	$(BIN_DIR)/prep_py \
	$(BIN_DIR)/prep_node \
	$(BIN_DIR)/bunn-prepare-harness \
	$(BIN_DIR)/bunn-test-harness \
	$(BIN_DIR)/guest-agent-static \
	$(BIN_DIR)/bunn \
	$(BIN_DIR)/bunn-network-helper

.PHONY: build build-runtime build-guest build-cli build-tools install-network-helper test vet fmt check clean help

help: ## Show available targets
	@awk 'BEGIN {FS = ":.*## "}; /^[a-zA-Z_-]+:.*## / {printf "  %-10s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

build: build-runtime build-guest build-cli build-tools ## Build all binaries into bin/

build-runtime: ## Build the runtime binary into bin/
	@mkdir -p $(BIN_DIR)
	GOWORK=off go build -o $(BIN_DIR)/bunn-burrow .

build-guest: ## Build the static guest agent into bin/
	@mkdir -p $(BIN_DIR)
	cd guest-agent && GOWORK=off CGO_ENABLED=0 go build -o ../$(BIN_DIR)/guest-agent-static ./cmd/guest-agent

build-cli: ## Build the CLI binary into bin/
	@mkdir -p $(BIN_DIR)
	GOWORK=off go build -o $(BIN_DIR)/bunn-network-helper ./cmd/bunn-network-helper
	cd bunn-cli && GOWORK=off go build -o ../$(BIN_DIR)/bunn ./cmd/bunn

install-network-helper: build-cli ## Install the root-owned, allowlisted network helper
	sudo install -D -o root -g root -m 0755 $(BIN_DIR)/bunn-network-helper /usr/local/libexec/bunn-burrow/bunn-network-helper

build-tools: ## Build the preparation and test tools into bin/
	@mkdir -p $(BIN_DIR)
	GOWORK=off go build -o $(BIN_DIR)/prep_py ./cmd/prep_py
	GOWORK=off go build -o $(BIN_DIR)/prep_node ./cmd/prep_node
	GOWORK=off go build -o $(BIN_DIR)/bunn-prepare-harness ./cmd/prepare
	GOWORK=off go build -o $(BIN_DIR)/bunn-test-harness ./cmd/test

test: ## Run tests in all Go modules
	@set -e; \
	for module in . guest-agent bunn-cli; do \
		printf '\n==> Testing %s\n' "$$module"; \
		(cd "$$module" && GOWORK=off go test -count=1 ./...); \
	done

vet: ## Run go vet in all Go modules
	@set -e; \
	for module in . guest-agent bunn-cli; do \
		printf '\n==> Vetting %s\n' "$$module"; \
		(cd "$$module" && GOWORK=off go vet ./...); \
	done

fmt: ## Format Go files in the three modules, excluding .git, bin, and vendor
	@find . \
		-path './guest-agent' -prune -o \
		-path './bunn-cli' -prune -o \
		-type d \( -name .git -o -name bin -o -name vendor \) -prune -o \
		-type f -name '*.go' -print0 | xargs -0 -r gofmt -w
	@find guest-agent bunn-cli \
		-type d \( -name .git -o -name bin -o -name vendor \) -prune -o \
		-type f -name '*.go' -print0 | xargs -0 -r gofmt -w

check: ## Verify that all expected binaries exist and are executable
	@set -e; \
	for binary in $(BINARIES); do \
		if [ ! -f "$$binary" ] || [ ! -x "$$binary" ]; then \
			printf 'Missing or non-executable binary: %s\n' "$$binary" >&2; \
			exit 1; \
		fi; \
		printf 'OK %s\n' "$$binary"; \
	done

clean: ## Remove binaries generated by build, preserving other bin/ contents
	rm -f $(BINARIES)
